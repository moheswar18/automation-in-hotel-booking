# ==============================================================================
# Ansible Inventory for StayEase Infrastructure
# ==============================================================================

[app_servers]
server1 ansible_host=10.0.10.21 ansible_user=ubuntu
server2 ansible_host=10.0.11.22 ansible_user=ubuntu

[monitoring]
monitor1 ansible_host=10.0.10.50 ansible_user=ubuntu

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/stayease-key.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
