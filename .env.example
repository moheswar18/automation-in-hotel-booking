# ==============================================================================
# StayEase Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# Server Environment
PORT=5000
HOST=0.0.0.0
DEBUG=True
CORS_ORIGINS=*

# JWT Authentication Secret (Generate a strong 256-bit key in production)
JWT_SECRET_KEY=production-stayease-jwt-secret-key-super-secure-32chars
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stayease_db
DB_USER=stayease_user
DB_PASSWORD=stayease_pass_2026

# Automatic fallback to local SQLite if MySQL service is not running locally
USE_SQLITE_FALLBACK=true

# AWS Cloud Deployment (Used by Terraform & CI/CD)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# S3 Automated Database Backups
S3_BACKUP_BUCKET=stayease-cloud-backups-2026
