# ==============================================================================
# Sample Terraform Variables Input
# Copy to terraform.tfvars and customize for real AWS deployment
# ==============================================================================

aws_region           = "us-east-1"
environment          = "production"
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

instance_type        = "t3.medium"
asg_min_size         = 2
asg_max_size         = 6
asg_desired_capacity = 2

db_name              = "stayease_db"
db_username          = "stayease_admin"
db_password          = "ChangeMeToStrongMasterPassword2026!"
